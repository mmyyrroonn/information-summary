generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AiRunKind {
  TWEET_CLASSIFY
  REPORT_SUMMARY
}

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum RoutingStatus {
  PENDING
  IGNORED
  AUTO_HIGH
  ROUTED
  LLM_QUEUED
  COMPLETED
}

enum SubscriptionStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum SourcePlatform {
  TWITTER
  YOUTUBE
  BILIBILI
  WECHAT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("user") // "admin" | "user"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions      Subscription[]
  reports           Report[]
  notificationConfig NotificationConfig?
}

model Subscription {
  id            String   @id @default(uuid())
  screenName    String   @unique
  displayName   String?
  avatarUrl     String?
  tags          String[] @default([])
  status        SubscriptionStatus @default(SUBSCRIBED)
  unsubscribedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastFetchedAt DateTime?
  
  // User relation (null = default subscription shared by all)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  
  tweets        Tweet[]
  sources       Source[]

  @@index([status, lastFetchedAt])
  @@index([userId])
}

model SourceList {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  enabled             Boolean  @default(true)
  scheduleCron        String   @default("*/15 * * * *")
  batchSize           Int      @default(20)
  sourceCooldownHours Int      @default(6)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sources        Source[]
  reportProfiles ReportProfile[]

  @@index([enabled, scheduleCron])
}

model Source {
  id             String         @id @default(uuid())
  list           SourceList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId         String
  platform       SourcePlatform
  identifier     String
  displayName    String?
  url            String?
  tags           String[]       @default([])
  enabled        Boolean        @default(true)
  lastFetchedAt  DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([listId, platform, identifier])
  @@index([listId, enabled, lastFetchedAt])
  @@index([platform, identifier])
  @@index([subscriptionId])
}

model Tweet {
  id             String   @id @default(uuid())
  tweetId        String   @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId String
  authorName     String
  authorScreen   String
  text           String
  lang           String?
  raw            Json
  tweetedAt      DateTime
  createdAt      DateTime @default(now())
  tweetUrl       String?
  processedAt    DateTime?
  abandonedAt    DateTime?
  abandonReason  String?
  routingStatus  RoutingStatus @default(PENDING)
  routingTag     String?
  routingDomain  String?
  routingScore   Float?
  routingMargin  Float?
  routingReason  String?
  routedAt       DateTime?
  llmQueuedAt    DateTime?
  insights       TweetInsight?
  embedding      TweetEmbedding?

  @@index([routingStatus, routingTag])
  @@index([routingStatus, llmQueuedAt])
}

model TweetInsight {
  id          String   @id @default(uuid())
  tweet       Tweet    @relation(fields: [tweetId], references: [tweetId])
  tweetId     String   @unique
  verdict     String
  summary     String?
  importance  Int?
  domain      String?
  tags        String[]
  suggestions String?
  embedding           Float[] @default([])
  embeddingModel     String?
  embeddingDimensions Int?
  embeddingTextHash  String?
  embeddedAt         DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  aiRun       AiRun?   @relation(fields: [aiRunId], references: [id])
  aiRunId     String?
}

model TweetEmbedding {
  id                 String   @id @default(uuid())
  tweet              Tweet    @relation(fields: [tweetId], references: [tweetId])
  tweetId            String   @unique
  embedding          Float[]  @default([])
  model              String
  dimensions         Int
  textHash           String
  embeddedAt         DateTime
  summaryEmbedding   Float[]  @default([])
  summaryModel       String?
  summaryDimensions  Int?
  summaryTextHash    String?
  summaryEmbeddedAt  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AiRun {
  id          String      @id @default(uuid())
  kind        AiRunKind
  status      AiRunStatus @default(PENDING)
  prompt      String?
  response    String?
  error       String?
  createdAt   DateTime    @default(now())
  completedAt DateTime?
  insights    TweetInsight[]
  report      Report?
}

model Report {
  id             String   @id @default(uuid())
  periodStart    DateTime
  periodEnd      DateTime
  headline       String
  content        String
  outline        Json?
  createdAt      DateTime @default(now())
  publishedAt    DateTime?
  aiRun          AiRun?   @relation(fields: [aiRunId], references: [id])
  aiRunId        String?  @unique
  profile        ReportProfile? @relation(fields: [profileId], references: [id])
  profileId      String?
  deliveredAt    DateTime?
  deliveryTarget String?
  
  // User relation
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RoutingEmbeddingCache {
  id               String   @id @default(uuid())
  model            String
  dimensions       Int
  positives        Json
  negatives        Json
  positiveCount    Int
  negativeCount    Int
  sourceWindowDays Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RoutingTagEmbeddingCache {
  id               String   @id @default(uuid())
  model            String
  dimensions       Int
  tagSamples       Json
  tagSampleCounts  Json
  samplePerTag     Int
  sourceWindowDays Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ReportProfile {
  id                     String   @id @default(uuid())
  name                   String
  enabled                Boolean  @default(true)
  scheduleCron           String
  windowHours            Int
  timezone               String
  includeTweetTags       String[] @default([])
  excludeTweetTags       String[] @default([])
  includeAuthorTags      String[] @default([])
  excludeAuthorTags      String[] @default([])
  domains                String[] @default([])
  minImportance          Int      @default(2)
  verdicts               String[] @default([])
  groupBy                String   @default("cluster")
  aiFilterEnabled        Boolean  @default(true)
  aiFilterPrompt         String?
  aiFilterMaxKeepPerChunk Int?
  sourceList             SourceList? @relation(fields: [sourceListId], references: [id], onDelete: SetNull)
  sourceListId           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  reports                Report[]

  @@index([enabled, scheduleCron])
  @@index([sourceListId])
}

model NotificationConfig {
  id                String   @id @default(uuid())

  // User relation (one config per user)
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])

  tgBotToken        String?
  tgChatId          String?
  tgMessageThreadId String?
  tgHighScoreMessageThreadId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BackgroundJob {
  id           String              @id @default(uuid())
  type         String
  payload      Json?
  status       BackgroundJobStatus @default(PENDING)
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(3)
  scheduledAt  DateTime            @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  completedAt  DateTime?
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, scheduledAt])
  @@index([type, status])
}

model SystemLock {
  key       String   @id
  lockedBy  String?
  lockedAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
